load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_integration_test", "rust_unit_test")

rust_package()

rust_library(
    name = "signalbox_tools_github",
    crate_root = "src/lib.rs",
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    deps = [
        "//crates/application:signalbox_application",
        "//crates/domain:signalbox_domain",
        "//crates/egress-transport:signalbox_egress_transport",
        "//crates/model-runtime:signalbox_model_runtime",
        "//crates/tool-contract:signalbox_tool_contract",
    ],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_tools_github",
    deps = ["//crates/application:signalbox_application"],
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_tools_github",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_tools_github",
)

rust_integration_test(
    name = "live_smoke",
    args = ["--test-threads=4"],
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/live_smoke.rs",
    data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/**/*.rs"],
    ) + [],
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/tools-github"},
    deps = [
        "//crates/application:signalbox_application",
        "//crates/domain:signalbox_domain",
        "//crates/egress-transport:signalbox_egress_transport",
        "//crates/model-runtime:signalbox_model_runtime",
        "//crates/tool-contract:signalbox_tool_contract",
        "//crates/tools-github:signalbox_tools_github",
    ],
)
