load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_quality_tests", "rust_unit_test")

CRATE_COMPILE_DATA = ["corpora/seed-v1.json"]

CRATE_PROC_MACRO_DEPS = ["//crates/derive:signalbox_derive"]

rust_package(exports = [
    "Cargo.toml",
    "corpora/seed-v1.json",
])

rust_library(
    name = "signalbox_approval_judge_eval",
    compile_data = CRATE_COMPILE_DATA,
    crate_root = "src/lib.rs",
    proc_macro_deps = CRATE_PROC_MACRO_DEPS,
    deps = [
        "//crates/domain:signalbox_domain",
    ],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_approval_judge_eval",
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_approval_judge_eval",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_approval_judge_eval",
)

rust_quality_tests(documented_crates = [
    ":signalbox_approval_judge_eval",
])
