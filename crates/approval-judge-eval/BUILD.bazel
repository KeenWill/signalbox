load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_library")

rust_package()

rust_library(
    name = "signalbox_approval_judge_eval",
    compile_data = ["corpora/seed-v1.json"],
    crate_root = "src/lib.rs",
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    deps = [
        "//apps/signalboxd:signalboxd_lib",
        "//crates/domain:signalbox_domain",
        "//crates/model-provider-runtime:signalbox_model_provider_runtime",
        "//crates/model-runtime:signalbox_model_runtime",
    ],
)

rust_binary(
    name = "signalbox-approval-judge-eval",
    compile_data = ["corpora/seed-v1.json"],
    crate_root = "src/main.rs",
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    deps = [
        ":signalbox_approval_judge_eval",
        "//apps/signalboxd:signalboxd_lib",
        "//crates/domain:signalbox_domain",
        "//crates/model-provider-runtime:signalbox_model_provider_runtime",
        "//crates/model-runtime:signalbox_model_runtime",
    ],
)

rust_test(
    name = "unit_tests",
    size = "large",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate = ":signalbox_approval_judge_eval",
    crate_features = [],
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--deny=warnings",
        "--forbid=unsafe_code",
    ],
    deps = [] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "signalbox_approval_judge_eval_unit_tests",
    size = "large",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate = ":signalbox-approval-judge-eval",
    crate_features = [],
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--deny=warnings",
        "--forbid=unsafe_code",
    ],
    deps = [] + all_crate_deps(normal_dev = True),
)
