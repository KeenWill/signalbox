load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_unit_test")

rust_package()

rust_library(
    name = "signalbox_approval_judge_eval",
    compile_data = ["corpora/seed-v1.json"],
    crate_root = "src/lib.rs",
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    deps = [
        "//apps/signalboxd:signalboxd_lib",
        "//crates/domain:signalbox_domain",
        "//crates/model-provider-runtime:signalbox_model_provider_runtime",
        "//crates/model-runtime:signalbox_model_runtime",
    ],
)

rust_binary(
    name = "signalbox-approval-judge-eval",
    compile_data = ["corpora/seed-v1.json"],
    crate_root = "src/main.rs",
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    deps = [
        ":signalbox_approval_judge_eval",
        "//apps/signalboxd:signalboxd_lib",
        "//crates/domain:signalbox_domain",
        "//crates/model-provider-runtime:signalbox_model_provider_runtime",
        "//crates/model-runtime:signalbox_model_runtime",
    ],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_approval_judge_eval",
)

rust_unit_test(
    name = "signalbox_approval_judge_eval_unit_tests",
    crate = ":signalbox-approval-judge-eval",
)
