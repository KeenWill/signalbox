load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_unit_test")

rust_package()

rust_library(
    name = "signalbox_egress_transport",
    crate_root = "src/lib.rs",
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_egress_transport",
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_egress_transport",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_egress_transport",
)
