load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

cargo_toml_env_vars(
    name = "cargo_environment",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "signalbox_program_runtime",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = [
        "default",
        "postgres-integration",
    ],
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//crates/domain:signalbox_domain",
        "//crates/persistence:signalbox_persistence",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "large",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate = ":signalbox_program_runtime",
    crate_features = [
        "default",
        "postgres-integration",
    ],
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--deny=warnings",
        "--forbid=unsafe_code",
    ],
    deps = ["//crates/persistence:signalbox_persistence"] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "program_host_postgres",
    size = "large",
    srcs = ["tests/program_host_postgres.rs"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = [
        "--ignored",
        "--test-threads=16",
    ],
    compile_data = ["//:tooling/postgres_test_image.rs"],
    crate_features = ["postgres-integration"],
    crate_root = "tests/program_host_postgres.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    tags = [
        "manual",
        "requires-network",
    ],
    deps = [
        ":signalbox_program_runtime",
        "//crates/domain:signalbox_domain",
        "//crates/persistence:signalbox_persistence",
        "@crates//:testcontainers-modules",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

test_suite(
    name = "postgres_tests",
    tags = ["manual"],
    tests = [":program_host_postgres"],
)
