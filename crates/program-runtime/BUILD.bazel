load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_postgres_test", "rust_unit_test")

CRATE_FEATURES = [
    "default",
    "postgres-integration",
]

rust_package()

rust_library(
    name = "signalbox_program_runtime",
    compile_data = glob(["src/**/*.js"]),
    crate_features = CRATE_FEATURES,
    crate_root = "src/lib.rs",
    deps = [
        "//crates/domain:signalbox_domain",
        "//crates/persistence:signalbox_persistence",
    ],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_program_runtime",
    crate_features = CRATE_FEATURES,
    deps = ["//crates/persistence:signalbox_persistence"],
)

rust_postgres_test(
    name = "program_host_postgres",
    crate_features = ["postgres-integration"],
    crate_root = "tests/program_host_postgres.rs",
    deps = [
        ":signalbox_program_runtime",
        "//crates/domain:signalbox_domain",
        "//crates/persistence:signalbox_persistence",
        "@crates//:testcontainers-modules",
    ],
)

test_suite(
    name = "postgres_tests",
    tags = ["manual"],
    tests = [":program_host_postgres"],
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_program_runtime",
    crate_features = CRATE_FEATURES,
)
