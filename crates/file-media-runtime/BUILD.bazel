load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_integration_test", "rust_unit_test")

CRATE_PROC_MACRO_DEPS = ["//crates/derive:signalbox_derive"]

rust_package()

rust_library(
    name = "signalbox_file_media_runtime",
    crate_root = "src/lib.rs",
    proc_macro_deps = CRATE_PROC_MACRO_DEPS,
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_file_media_runtime",
)

rust_integration_test(
    name = "registry_conformance",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/registry_conformance.rs",
    proc_macro_deps = CRATE_PROC_MACRO_DEPS,
    deps = [":signalbox_file_media_runtime"],
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_file_media_runtime",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_file_media_runtime",
)
