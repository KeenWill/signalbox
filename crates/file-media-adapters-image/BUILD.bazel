load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_doc_test", "rust_integration_test", "rust_unit_test")

CRATE_DEPS = [
    ":signalbox_file_media_adapters_image",
    "//crates/file-media-processor-runtime:signalbox_file_media_processor_runtime",
    "//crates/file-media-runtime:signalbox_file_media_runtime",
]

rust_package()

rust_library(
    name = "signalbox_file_media_adapters_image",
    crate_root = "src/lib.rs",
    deps = [
        "//crates/file-media-processor-runtime:signalbox_file_media_processor_runtime",
        "//crates/file-media-runtime:signalbox_file_media_runtime",
    ],
)

rust_binary(
    name = "signalbox-file-media-image-worker",
    crate_root = "src/bin/signalbox-file-media-image-worker.rs",
    deps = CRATE_DEPS,
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_file_media_adapters_image",
)

rust_unit_test(
    name = "signalbox_file_media_image_worker_unit_tests",
    crate = ":signalbox-file-media-image-worker",
)

rust_integration_test(
    name = "adapters",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/adapters.rs",
    deps = CRATE_DEPS,
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_file_media_adapters_image",
)
