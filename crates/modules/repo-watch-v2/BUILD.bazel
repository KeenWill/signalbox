load("@crates//:defs.bzl", "all_crate_deps")
load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_doc_test", "rust_unit_test")

CRATE_FEATURES = ["test-support"]

rust_package()

rust_library(
    name = "signalbox_module_repo_watch_v2",
    crate_features = CRATE_FEATURES,
    crate_root = "src/lib.rs",
    deps = ["//crates/ownership-seam:signalbox_ownership_seam"],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_module_repo_watch_v2",
    crate_features = CRATE_FEATURES,
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_module_repo_watch_v2",
    crate_features = ["test-support"],
)

rust_binary(
    name = "observation_probe",
    srcs = ["examples/observation_probe.rs"],
    crate_root = "examples/observation_probe.rs",
    deps = [
        ":signalbox_module_repo_watch_v2",
        "//crates/ownership-seam:signalbox_ownership_seam",
    ] + all_crate_deps(normal_dev = True),
)
