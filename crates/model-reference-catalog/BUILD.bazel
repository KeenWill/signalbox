load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_unit_test")

CRATE_COMPILE_DATA = ["data/reference-catalog.json"]

rust_package()

rust_library(
    name = "signalbox_model_reference_catalog",
    compile_data = CRATE_COMPILE_DATA,
    crate_root = "src/lib.rs",
)

rust_binary(
    name = "generate-reference-projections",
    compile_data = CRATE_COMPILE_DATA,
    crate_root = "src/bin/generate-reference-projections.rs",
    deps = [":signalbox_model_reference_catalog"],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_model_reference_catalog",
)

rust_unit_test(
    name = "generate_reference_projections_unit_tests",
    crate = ":generate-reference-projections",
)

filegroup(
    name = "projections",
    srcs = glob(["projections/*.md"]),
    visibility = ["//:__pkg__"],
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_model_reference_catalog",
)
