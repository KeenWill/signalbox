load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "signalbox_blob_store",
    srcs = glob(["src/*.rs"]),
    aliases = aliases(),
    crate_features = ["test-support"],
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = ["//crates/domain:signalbox_domain"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":signalbox_blob_store",
    lint_config = ":cargo_lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    deps = all_crate_deps(normal_dev = True),
)
