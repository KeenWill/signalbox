load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_integration_test", "rust_quality_tests", "rust_unit_test")

rust_package()

rust_library(
    name = "signalbox_model_runtime_anthropic",
    crate_root = "src/lib.rs",
    deps = ["//crates/model-runtime:signalbox_model_runtime"],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_model_runtime_anthropic",
)

rust_integration_test(
    name = "loopback",
    size = "small",
    crate_root = "tests/loopback.rs",
    deps = [
        ":signalbox_model_runtime_anthropic",
        "//crates/model-runtime:signalbox_model_runtime",
    ],
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_model_runtime_anthropic",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_model_runtime_anthropic",
)

rust_integration_test(
    name = "live_smoke",
    srcs = glob(["tests/**/*.rs"]),
    args = ["--test-threads=4"],
    crate_root = "tests/live_smoke.rs",
    data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/**/*.rs"],
    ) + [],
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/model-runtime-anthropic"},
    deps = [
        "//crates/model-runtime:signalbox_model_runtime",
        "//crates/model-runtime-anthropic:signalbox_model_runtime_anthropic",
    ],
)

rust_quality_tests(documented_crates = [":signalbox_model_runtime_anthropic"])
