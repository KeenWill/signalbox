load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_doc_test", "rust_integration_test", "rust_quality_tests", "rust_unit_test")

CRATE_DEPS = [
    ":signalbox_file_media_adapter_svg",
    "//crates/file-media-adapters-image:signalbox_file_media_adapters_image",
    "//crates/file-media-processor-runtime:signalbox_file_media_processor_runtime",
    "//crates/file-media-runtime:signalbox_file_media_runtime",
]

rust_package()

rust_library(
    name = "signalbox_file_media_adapter_svg",
    crate_root = "src/lib.rs",
    compile_data = glob(["fonts/*"]),
    deps = [
        "//crates/file-media-adapters-image:signalbox_file_media_adapters_image",
        "//crates/file-media-processor-runtime:signalbox_file_media_processor_runtime",
        "//crates/file-media-runtime:signalbox_file_media_runtime",
    ],
)

rust_binary(
    name = "signalbox-file-media-svg-worker",
    crate_root = "src/bin/signalbox-file-media-svg-worker.rs",
    deps = CRATE_DEPS,
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_file_media_adapter_svg",
)

rust_unit_test(
    name = "signalbox_file_media_svg_worker_unit_tests",
    crate = ":signalbox-file-media-svg-worker",
)

rust_integration_test(
    name = "svg_adapter",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/svg_adapter.rs",
    data = [":signalbox-file-media-svg-worker", "//crates/file-media-adapters-image:signalbox-file-media-image-worker"],
    env = {
        "NEXTEST_BIN_EXE_signalbox_file_media_svg_worker": "$(rootpath :signalbox-file-media-svg-worker)",
        "NEXTEST_BIN_EXE_signalbox_file_media_image_worker": "$(rootpath //crates/file-media-adapters-image:signalbox-file-media-image-worker)",
    },
    env_inherit = ["SIGNALBOX_FILE_MEDIA_CGROUP_ROOT"],
    rustc_env = {"CARGO_BIN_EXE_signalbox-file-media-svg-worker": "$(rootpath :signalbox-file-media-svg-worker)"},
    deps = CRATE_DEPS,
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_file_media_adapter_svg",
)

rust_quality_tests(documented_crates = [
    ":signalbox_file_media_adapter_svg",
    ":signalbox-file-media-svg-worker",
])
