load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_quality_tests", "rust_unit_test")

rust_package()

rust_library(
    name = "signalbox_github_transport",
    crate_root = "src/lib.rs",
    deps = ["//crates/egress-transport:signalbox_egress_transport"],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_github_transport",
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_github_transport",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_github_transport",
)

rust_quality_tests(documented_crates = [":signalbox_github_transport"])
