load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_proc_macro")
load("//tooling/bazel:testing.bzl", "rust_doc_test", "rust_integration_test", "rust_quality_tests", "rust_unit_test")

TEST_PROC_MACRO_DEPS = [":signalbox_derive"]

rust_package()

rust_proc_macro(
    name = "signalbox_derive",
)

rust_binary(
    name = "module_sources",
    srcs = ["src/bin/module_sources.rs"],
    crate_root = "src/bin/module_sources.rs",
    visibility = ["//:__pkg__"],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_derive",
)

rust_integration_test(
    name = "accessors",
    size = "small",
    crate_root = "tests/accessors.rs",
    proc_macro_deps = TEST_PROC_MACRO_DEPS,
)

rust_integration_test(
    name = "operator_error",
    size = "small",
    crate_root = "tests/operator_error.rs",
    proc_macro_deps = TEST_PROC_MACRO_DEPS,
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_derive",
)

rust_integration_test(
    name = "compile_fail",
    srcs = glob(["tests/**/*.rs"]),
    args = ["--test-threads=4"],
    crate_root = "tests/compile_fail.rs",
    data = ["Cargo.toml"] + glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/**/*.rs"],
    ) + [],
    env = {"SIGNALBOX_TEST_MANIFEST": "$(rootpath Cargo.toml)"},
    env_inherit = [
        "HOME",
        "CARGO_HOME",
        "RUSTUP_HOME",
    ],
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/derive"},
    tags = [
        "external",
        "no-sandbox",
    ],
)

rust_quality_tests(documented_crates = [":signalbox_derive"])
