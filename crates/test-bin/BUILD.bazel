load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_doc_test", "rust_unit_test")

rust_package()

rust_library(
    name = "signalbox_test_bin",
    crate_root = "src/lib.rs",
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_test_bin",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_test_bin",
)
