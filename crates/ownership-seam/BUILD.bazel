load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library", "rust_test")

CRATE_FEATURES = ["test-support"]

exports_files(["Cargo.toml"])

cargo_toml_env_vars(
    name = "cargo_environment",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "signalbox_ownership_seam",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = CRATE_FEATURES,
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//crates/application:signalbox_application",
        "//crates/domain:signalbox_domain",
        "//crates/persistence:signalbox_persistence",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "large",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate = ":signalbox_ownership_seam",
    crate_features = ["test-support"],
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--deny=warnings",
        "--forbid=unsafe_code",
    ],
    deps = [] + all_crate_deps(normal_dev = True),
)

filegroup(
    name = "rust_sources",
    srcs = glob(["**/*.rs"]),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "lifecycle_vocabulary",
    size = "small",
    srcs = ["tests/lifecycle_vocabulary.rs"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate_features = ["test-support"],
    crate_root = "tests/lifecycle_vocabulary.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    tags = [],
    deps = [
        ":signalbox_ownership_seam",
        "//crates/application:signalbox_application",
        "//crates/domain:signalbox_domain",
        "//crates/persistence:signalbox_persistence",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_doc(
    name = "api_json",
    crate = ":signalbox_ownership_seam",
    crate_features = CRATE_FEATURES,
    rustdoc_flags = [
        "-Z",
        "unstable-options",
        "--output-format",
        "json",
    ],
    visibility = ["//:__pkg__"],
)
