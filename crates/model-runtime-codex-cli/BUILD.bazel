load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

exports_files(["Cargo.toml"])

cargo_toml_env_vars(
    name = "cargo_environment",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

cargo_build_script(
    name = "build_script",
    srcs = [
        "build.rs",
        "version_pin.rs",
    ],
    crate_root = "build.rs",
    data = [
        "Cargo.toml",
        "//:tooling/codex-cli/package.json",
    ],
    edition = crate_edition(),
    rustc_env_files = [":cargo_environment"],
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "signalbox_model_runtime_codex_cli",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = [],
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":build_script",
        "//crates/model-runtime:signalbox_model_runtime",
    ] + all_crate_deps(normal = True),
)

rust_binary(
    name = "signalbox-fake-codex-cli",
    srcs = glob(["tests/support/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = [],
    crate_root = "tests/support/fake_codex_cli.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":build_script",
        ":signalbox_model_runtime_codex_cli",
        "//crates/model-runtime:signalbox_model_runtime",
    ] + all_crate_deps(normal = True),
)
