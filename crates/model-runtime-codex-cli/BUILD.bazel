load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_library", "rust_test")
load("//tooling/bazel:package.bzl", "rust_package")

rust_package()

cargo_build_script(
    name = "build_script",
    srcs = [
        "build.rs",
        "version_pin.rs",
    ],
    crate_root = "build.rs",
    data = [
        "Cargo.toml",
        "//:tooling/codex-cli/release.json",
    ],
    edition = crate_edition(),
    rustc_env_files = [":cargo_environment"],
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "signalbox_model_runtime_codex_cli",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = [],
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":build_script",
        "//crates/model-runtime:signalbox_model_runtime",
    ] + all_crate_deps(normal = True),
)

rust_binary(
    name = "signalbox-fake-codex-cli",
    srcs = glob(["tests/support/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = [],
    crate_root = "tests/support/fake_codex_cli.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":build_script",
        ":signalbox_model_runtime_codex_cli",
        "//crates/model-runtime:signalbox_model_runtime",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "large",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate = ":signalbox_model_runtime_codex_cli",
    crate_features = [],
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--deny=warnings",
        "--forbid=unsafe_code",
    ],
    # These tests execute host shell or process utilities.
    tags = ["external"],
    deps = ["//crates/test-bin:signalbox_test_bin"] + all_crate_deps(normal_dev = True),
)

rust_doc(
    name = "api_json",
    crate = ":signalbox_model_runtime_codex_cli",
    rustdoc_flags = [
        "-Z",
        "unstable-options",
        "--output-format",
        "json",
    ],
    visibility = ["//:__pkg__"],
)
