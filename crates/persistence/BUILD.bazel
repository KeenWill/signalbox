load("@postgres_suites//:defs.bzl", "SUITES")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_integration_test", "rust_postgres_test", "rust_quality_tests", "rust_selection_test", "rust_unit_test")

CRATE_FEATURES = SUITES["persistence"]["crate_features"]

CRATE_PROC_MACRO_DEPS = ["//crates/derive:signalbox_derive"]

TEST_DEPS = [
    ":signalbox_persistence",
    "//crates/application:signalbox_application",
    "//crates/blob-store:signalbox_blob_store",
    "//crates/conversation-import-claude-code:signalbox_conversation_import_claude_code",
    "//crates/conversation-import-codex:signalbox_conversation_import_codex",
    "//crates/domain:signalbox_domain",
    "//crates/newtype:signalbox_newtype",
    "//crates/tools-plan:signalbox_tools_plan",
]

rust_package()

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    data = glob(["migrations/*.sql"]),
    edition = "2024",
    lint_config = ":cargo_lints",
    rustc_env_files = [":cargo_environment"],
)

rust_library(
    name = "signalbox_persistence",
    compile_data = glob(["migrations/*.sql"]) + ["//:config/signalboxd.example.toml"],
    crate_features = CRATE_FEATURES,
    proc_macro_deps = CRATE_PROC_MACRO_DEPS,
    deps = [
        "//crates/application:signalbox_application",
        "//crates/blob-store:signalbox_blob_store",
        "//crates/domain:signalbox_domain",
        "//crates/newtype:signalbox_newtype",
        "//crates/tools-plan:signalbox_tools_plan",
    ],
)

