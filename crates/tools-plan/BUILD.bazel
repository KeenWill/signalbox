load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_api_json", "rust_doc_test", "rust_quality_tests", "rust_unit_test")

rust_package()

rust_library(
    name = "signalbox_tools_plan",
    proc_macro_deps = ["//crates/derive:signalbox_derive"],
    deps = [
        "//crates/application:signalbox_application",
        "//crates/domain:signalbox_domain",
        "//crates/newtype:signalbox_newtype",
        "//crates/tool-contract:signalbox_tool_contract",
    ],
)

rust_unit_test(
    name = "unit_tests",
    crate = ":signalbox_tools_plan",
)

rust_api_json(
    name = "api_json",
    crate = ":signalbox_tools_plan",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_tools_plan",
)

rust_quality_tests(documented_crates = [":signalbox_tools_plan"])
