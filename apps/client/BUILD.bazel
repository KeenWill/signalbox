load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

cargo_toml_env_vars(
    name = "cargo_environment",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

extract_cargo_lints(
    name = "cargo_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "signalbox_client",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = [],
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = ["//crates/process-protocol:signalbox_process_protocol"] + all_crate_deps(normal = True),
)

rust_binary(
    name = "signalbox",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [],
    crate_features = [],
    crate_root = "src/main.rs",
    edition = crate_edition(),
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_environment"],
    rustc_flags = [
        "--forbid=unsafe_code",
        "--deny=warnings",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":signalbox_client",
        "//crates/process-protocol:signalbox_process_protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    size = "large",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate = ":signalbox_client",
    crate_features = [],
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--deny=warnings",
        "--forbid=unsafe_code",
    ],
    deps = [
        "//apps/signalboxd:signalboxd_lib",
        "//crates/application:signalbox_application",
        "//crates/domain:signalbox_domain",
        "//crates/model-provider-runtime:signalbox_model_provider_runtime",
        "//crates/model-runtime:signalbox_model_runtime",
        "//crates/model-runtime-anthropic:signalbox_model_runtime_anthropic",
        "//crates/persistence:signalbox_persistence",
        "//crates/test-bin:signalbox_test_bin",
    ] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "signalbox_unit_tests",
    size = "large",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["--test-threads=16"],
    crate = ":signalbox",
    crate_features = [],
    lint_config = ":cargo_lints",
    proc_macro_deps = [] + all_crate_deps(proc_macro_dev = True),
    rustc_flags = [
        "--deny=warnings",
        "--forbid=unsafe_code",
    ],
    deps = [
        "//apps/signalboxd:signalboxd_lib",
        "//crates/application:signalbox_application",
        "//crates/domain:signalbox_domain",
        "//crates/model-provider-runtime:signalbox_model_provider_runtime",
        "//crates/model-runtime:signalbox_model_runtime",
        "//crates/model-runtime-anthropic:signalbox_model_runtime_anthropic",
        "//crates/persistence:signalbox_persistence",
        "//crates/test-bin:signalbox_test_bin",
    ] + all_crate_deps(normal_dev = True),
)

filegroup(
    name = "rust_sources",
    srcs = glob(["**/*.rs"]),
    visibility = ["//:__pkg__"],
)
