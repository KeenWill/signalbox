load("//tooling/bazel:package.bzl", "rust_package")
load("//tooling/bazel:rust.bzl", "rust_binary", "rust_library")
load("//tooling/bazel:testing.bzl", "rust_doc_test", "rust_integration_test", "rust_quality_tests", "rust_unit_test")

CRATE_COMPILE_DATA = ["//:config/signalbox-runner.example.toml"]

rust_package()

rust_library(
    name = "signalbox_runner",
    compile_data = CRATE_COMPILE_DATA,
    crate_root = "src/lib.rs",
    deps = [
        "//crates/domain:signalbox_domain",
        "//crates/runner-wire:signalbox_runner_wire",
        "//crates/tools-basic:signalbox_tools_basic",
    ],
)

rust_binary(
    name = "signalbox-runner",
    compile_data = CRATE_COMPILE_DATA,
    crate_root = "src/main.rs",
    deps = [
        ":signalbox_runner",
        "//crates/runner-wire:signalbox_runner_wire",
    ],
)

rust_unit_test(
    name = "unit_tests",
    # Forking fixture children can retain another test's root lock until exec.
    args = ["--test-threads=1", "--skip", "ambient::tests"],
    crate = ":signalbox_runner",
)

rust_unit_test(
    name = "signalbox_runner_unit_tests",
    crate = ":signalbox-runner",
)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalbox_runner",
)

rust_integration_test(
    name = "ambient_registration",
    args = ["--test-threads=1"],
    crate_root = "tests/ambient_registration.rs",
    data = [":signalbox-runner"],
    env = {
        "NEXTEST_BIN_EXE_signalbox_runner": "$(rootpath :signalbox-runner)",
        "TMPDIR": "/tmp",
    },
    rustc_env = {
        "CARGO_BIN_EXE_signalbox-runner": "$(rootpath :signalbox-runner)",
    },
    tags = ["external", "manual", "no-sandbox"],
    deps = [
        "//crates/runner-wire:signalbox_runner_wire",
        "//crates/test-bin:signalbox_test_bin",
    ],
)

rust_quality_tests(documented_crates = [
    ":signalbox_runner",
    ":signalbox-runner",
])
