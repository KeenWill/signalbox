)

rust_doc_test(
    name = "doc_tests",
    crate = ":signalboxd_lib",
    crate_features = ["test-support"],
)

rust_integration_test(
    name = "live_tool_evals",
    srcs = glob(["tests/**/*.rs"]),
    args = ["--test-threads=4"],
    compile_data = [
        "//:config/signalboxd.example.toml",
        "//:tooling/postgres_test_image.rs",
    ],
    crate_features = ["test-support"],
    crate_root = "tests/live_tool_evals/main.rs",
    data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/**/*.rs"],
    ) + [
        ":approval-judge-eval",
        ":signalbox-debug",
        ":signalboxd",
    ],
    env = {
        "TMPDIR": "/tmp",
        "NEXTEST_BIN_EXE_approval_judge_eval": "$(rootpath :approval-judge-eval)",
        "NEXTEST_BIN_EXE_signalbox_debug": "$(rootpath :signalbox-debug)",
        "NEXTEST_BIN_EXE_signalboxd": "$(rootpath :signalboxd)",
    },
    proc_macro_deps = CRATE_PROC_MACRO_DEPS,
    rustc_env = {
        "CARGO_MANIFEST_DIR": "apps/signalboxd",
        "CARGO_BIN_EXE_approval-judge-eval": "$(rootpath :approval-judge-eval)",
        "CARGO_BIN_EXE_signalbox-debug": "$(rootpath :signalbox-debug)",
        "CARGO_BIN_EXE_signalboxd": "$(rootpath :signalboxd)",
    },
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = CRATE_DEPS + ["//crates/test-bin:signalbox_test_bin"],
)

