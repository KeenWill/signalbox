rust_unit_test(
    name = "unit_tests",
    compile_data = ["//crates/process-protocol:src/request.rs"],
    crate = ":signalboxd_lib",
    crate_features = ["test-support"],
    data = [
        "Cargo.toml",
        "//:config/session-templates.example.toml",
        "//:config/signalboxd.example.toml",
        "//crates/convergence:examples/repository.toml",
        "//crates/model-runtime-claude-cli:signalbox-claude-mcp-bridge",
    ],
    # Unix socket paths must fit sockaddr_un even under a long Bazel output root.
    env = {
        "NEXTEST_BIN_EXE_signalbox_claude_mcp_bridge": "$(rootpath //crates/model-runtime-claude-cli:signalbox-claude-mcp-bridge)",
        "TMPDIR": "/tmp",
    },
    rustc_env = {"CARGO_MANIFEST_DIR": "apps/signalboxd"},
    # Socket ownership and host-tool tests need the host's actual UID mapping.
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "//crates/application:signalbox_application",
        "//crates/blob-store-filesystem:signalbox_blob_store_filesystem",
        "//crates/persistence:signalbox_persistence",
        "//crates/test-bin:signalbox_test_bin",
    ],
)

