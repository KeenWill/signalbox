// Explicit dependency-update policy; git history retains its adoption context.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate's maintained baseline: monorepo groupings, replacement rules for
  // renamed packages, and workarounds for known upstream oddities. Every
  // policy choice below is explicit and overrides it where they overlap.
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "internalChecksFilter": "strict",
  // The cargo manager's default file pattern ((^|/)Cargo\.toml$) already
  // covers the root manifest and every workspace member under crates/ and
  // apps/, so no path configuration is needed for full workspace coverage.
  // The npm manager's default file pattern ((^|/)package\.json$) already covers
  // tooling/codex-cli, the tree's only npm manifest. It exists solely to pin
  // the wrapped Codex CLI executable to an exact version; see the Codex CLI
  // provider adapter section of docs/spec/runtime-substrate.md.
  //
  // The development toolchain — devenv.yaml and devenv.lock — is deliberately
  // outside all of this, and the nix manager's absence is not an oversight to
  // be corrected. That manager matches flake.nix and maintains the flake.lock
  // beside it; this tree has no flake at any path, so the manager finds
  // nothing to read. The tempting repair is the reason this note exists: a
  // customManagers regex over devenv.lock would be worse than the gap it
  // closes. Every locked node there records a narHash beside its rev, Renovate
  // has no way to compute one, and a bumped rev still carrying the previous
  // hash is a lock Nix refuses to evaluate — so the result is a broken
  // development environment arriving in a pull request that looks like a
  // working update, which is a worse failure than an unmanaged pin. Re-locking
  // belongs to the tool that can hash what it fetched, so
  // .github/workflows/devenv-lock.yml runs `devenv update` on a weekly
  // schedule and opens a pull request when the lock actually moves; its header
  // carries the rest of the reasoning.
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": false,
    },
    {
      // Activation requires branch protection to make the Rust and
      // supply-chain checks required.
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
    },
    {
      // Deliberately carries no minimum-release-age gate and no automerge, on
      // both counts unlike the cargo policy above. The wrapped CLI releases
      // far too often for calendar age to mean anything, and what makes a bump
      // safe is evidence, not waiting: the adapter build mechanically derives
      // its supported-version constant from the exact manifest pin, and the
      // automatic pull-request compatibility smoke
      // (.github/workflows/codex-smoke.yml) installs and proves that pin against
      // the real CLI. Neither gate validates the recorded offline event-shape
      // fixtures; docs/open-questions.md tracks that residual coverage gap.
      // The evidence remains human-reviewed, so the pull request must never
      // merge itself.
      "matchManagers": ["npm"],
      "rangeStrategy": "pin",
      "automerge": false,
    },
  ],
}
