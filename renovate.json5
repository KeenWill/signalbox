// Explicit dependency-update policy; git history retains its adoption context.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate's maintained baseline: monorepo groupings, replacement rules for
  // renamed packages, and workarounds for known upstream oddities. Every
  // policy choice below is explicit and overrides it where they overlap.
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "internalChecksFilter": "strict",
  // The cargo manager's default file pattern ((^|/)Cargo\.toml$) already
  // covers the root manifest and every workspace member under crates/ and
  // apps/, so no path configuration is needed for full workspace coverage.
  // The npm manager's default file pattern ((^|/)package\.json$) covers every
  // npm manifest in the tree. Two of them are not Node projects: each of
  // tooling/codex-cli and crates/model-runtime-claude-cli exists solely to pin
  // one wrapped CLI executable to an exact version, and each pin bump is
  // proven against the real CLI by that adapter's own compatibility smoke
  // (.github/workflows/codex-smoke.yml and .github/workflows/claude-smoke.yml).
  // See the Codex CLI and Claude Code CLI provider adapter sections of
  // docs/spec/runtime-substrate.md. The third, clients/web, is a real Node
  // project with a real dependency tree; its cooldown rules are below.
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": false,
    },
    {
      // Activation requires branch protection to make the Rust and
      // supply-chain checks required.
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
    },
    {
      // deno_error is not an independent dependency: its sole use is naming
      // deno_core's error type (use deno_error::JsErrorBox in
      // crates/program-runtime), and every deno_core release since 0.388.0
      // pins deno_error exactly (=0.7.1 today). It can only ever move when
      // deno_core moves, so Renovate must not propose it on its own — that
      // produced the unresolvable PR #921 chasing 0.7.3, a misnumbered
      // release (published 1.4s before 0.7.2) the deno ecosystem never
      // adopted.
      "matchManagers": ["cargo"],
      "matchPackageNames": ["deno_error"],
      "enabled": false,
    },
    {
      // Baseline for every npm manifest: exact pins, human-reviewed merges.
      // For the two CLI-pin manifests this is deliberately the whole policy —
      // no minimum-release-age gate, unlike the cargo policy above. The
      // wrapped CLI releases far too often for calendar age to mean anything,
      // and what makes a pin bump safe is evidence, not waiting: the adapter
      // build mechanically derives its supported-version constant from the
      // exact manifest pin, and the automatic pull-request compatibility
      // smokes (.github/workflows/codex-smoke.yml and
      // .github/workflows/claude-smoke.yml) install and prove those pins
      // against the real CLIs. Neither gate validates the recorded offline
      // event-shape fixtures; docs/open-questions.md tracks that residual
      // coverage gap. The evidence remains human-reviewed, so the pull request
      // must never merge itself.
      "matchManagers": ["npm"],
      "rangeStrategy": "pin",
      "automerge": false,
    },
    {
      // The web client is a real dependency tree, not an evidence-gated CLI
      // pin, so unlike the manifests above it gets the same supply-chain
      // cooldown as cargo: a newly cut release waits out the window in which
      // a compromised or broken version is typically caught and yanked before
      // Renovate proposes it here.
      // "pin" is included because pin refreshes adopt whatever version is
      // newest at refresh time: without it, Renovate advanced the Node.js
      // engine pin to 26.8.1 the day it was released (PR #1014), bypassing
      // the aging window this rule exists to enforce.
      "matchManagers": ["npm"],
      "matchFileNames": ["clients/web/**"],
      "matchUpdateTypes": ["patch", "minor", "pin"],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["clients/web/**"],
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
    },
  ],
}
