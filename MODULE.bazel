module(name = "signalbox")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Match Cargo formatting and build-script lint policy.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//tooling/bazel:patches/rustfmt-crate-roots.patch",
        "//tooling/bazel:patches/build-script-lints.patch",
        "//tooling/bazel:patches/coverage-subprocesses.patch",
    ],
)

bazel_dep(name = "gcc_toolchain", version = "0.12.0")
bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "toml.bzl", version = "0.4.1")

rust_toolchain_pin = use_repo_rule("//tooling/bazel:rust_toolchain_pin.bzl", "rust_toolchain_pin")

rust_toolchain_pin(
    name = "rust_toolchain_pin",
    manifest = "//:rust-toolchain.toml",
)

postgres = use_extension("//tooling/bazel:postgres_suites.bzl", "postgres_suites")
use_repo(postgres, "postgres_suites")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "26.8.1")
use_repo(node, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:all")

python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "python_deps",
    python_version = "3.14",
    requirements_lock = "//:tooling/requirements-mdformat.txt",
)
use_repo(pip, "python_deps")

gcc = use_extension("@gcc_toolchain//toolchain:module_extensions.bzl", "gcc_toolchains")
gcc.toolchain(
    name = "gcc_linux_x86_64",
    target_arch = "x86_64",
)
use_repo(gcc, "gcc_linux_x86_64")

register_toolchains("@gcc_linux_x86_64//:all")

RUST_VERSION = "1.98.1"

RUSTDOC_TOOLCHAIN = "nightly-2026-09-11"

rust = use_extension("//tooling/bazel:rust_toolchains.bzl", "rust")
rust.toolchain(
    edition = "2024",
    rustfmt_version = RUST_VERSION,
    versions = [
        RUST_VERSION,
        RUSTDOC_TOOLCHAIN.replace("nightly-", "nightly/"),
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

host_tools = use_extension("//tooling/bazel:rust_toolchains.bzl", "rust_host_tools")
host_tools.host_tools(
    name = "signalbox_rust_host_tools",
    version = RUST_VERSION,
)
use_repo(host_tools, "signalbox_rust_host_tools")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

v8 = use_extension("//tooling/bazel:v8.bzl", "v8")
use_repo(v8, "rusty_v8_archive")

# Cached binaries cannot load JavaScript from a previous compilation sandbox.
crate.annotation(
    crate = "serde_json",
    patch_args = ["-p1"],
    patches = ["//tooling/bazel:patches/serde-json-suite-order.patch"],
)
crate.annotation(
    crate = "deno_core",
    patch_args = ["-p1"],
    patches = ["//tooling/bazel:patches/deno-embedded-javascript.patch"],
)
crate.annotation(
    build_script_data = ["@rusty_v8_archive//file"],
    build_script_env = {
        "RUSTY_V8_ARCHIVE": "$(execpath @rusty_v8_archive//file)",
        "RUSTY_V8_SRC_BINDING_PATH": "../gen/src_binding_simdutf_release_x86_64-unknown-linux-gnu.rs",
    },
    crate = "v8",
    label_injections = {"@rusty_v8_archive": "@rusty_v8_archive"},
    patch_args = ["-p1"],
    patches = ["//tooling/bazel:patches/v8-build-output.patch"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    host_tools = "@signalbox_rust_host_tools",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "patchelf",
    build_file_content = 'exports_files(["bin/patchelf"])',
    sha256 = "ce84f2447fb7a8679e58bc54a20dc2b01b37b5802e12c57eece772a6f14bf3f0",
    urls = ["https://github.com/NixOS/patchelf/releases/download/0.18.0/patchelf-0.18.0-x86_64.tar.gz"],
)

http_archive(
    name = "linux_test_runtime",
    build_file_content = """filegroup(
    name = "libraries",
    srcs = glob(["usr/lib/x86_64-linux-gnu/*.so*"], allow_empty = False),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "c1e67ef7b17a6300e136118bd1dc04725009cb376c1aad10abcf8cd453628d58",
    urls = ["https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/ubuntu-base-24.04.4-base-amd64.tar.gz"],
)

bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version = "10.34.5")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//clients/web:package.json",
        "//clients/web:pnpm-workspace.yaml",
    ],
    npm_package_lock = "//clients/web:package-lock.json",
    pnpm_lock = "//clients/web:pnpm-lock.yaml",
    update_pnpm_lock = True,
    use_home_npmrc = False,
)
use_repo(npm, "npm")

playwright = use_extension("//tooling/bazel:playwright.bzl", "playwright")
use_repo(playwright, "playwright_runtime")

web_public_repository = use_repo_rule("//tooling/bazel:web_public.bzl", "web_public_repository")

web_public_repository(name = "web_public")
