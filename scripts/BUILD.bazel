load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "review_citations",
    srcs = ["review_citations.py"],
    imports = ["."],
)

py_library(
    name = "review_judge_eval",
    srcs = ["review_judge_eval.py"],
    imports = ["."],
    deps = [":review_citations"],
)

[
    py_test(
        name = "test_" + module,
        size = "small",
        srcs = ["test_" + module + ".py"],
        tags = ["external"],
        deps = [":" + module],
    )
    for module in ["review_citations", "review_judge_eval"]
]

[
    py_library(
        name = checker,
        srcs = [checker + ".py"],
        imports = ["."],
    )
    for checker in [
        "check_migration_versions",
        "check_session_ownership",
    ]
]

py_library(
    name = "domain_spine",
    srcs = [
        "domain_spine_digest.py",
        "render_domain_spine.py",
    ],
    imports = ["."],
)

py_binary(
    name = "render_api",
    srcs = ["render_domain_spine.py"],
    data = ["@rules_rust//rust/toolchain:current_rustfmt_toolchain"],
    env = {"RUSTFMT": "$(execpath @rules_rust//rust/toolchain:current_rustfmt_toolchain)"},
    main = "render_domain_spine.py",
    visibility = ["//visibility:public"],
    deps = [":domain_spine"],
)

py_library(
    name = "postgres_integration_suites",
    srcs = ["postgres_integration_suites.py"],
    imports = ["."],
    deps = [requirement("PyYAML")],
)

py_library(
    name = "check_docs_consistency",
    srcs = ["check_docs_consistency.py"],
    imports = ["."],
    deps = [
        ":postgres_integration_suites",
        requirement("markdown-it-py"),
    ],
)

[
    py_test(
        name = "test_" + checker,
        size = "small",
        srcs = ["test_" + checker + ".py"],
        deps = [":" + checker],
    )
    for checker in [
        "check_migration_versions",
        "check_session_ownership",
    ]
]

py_test(
    name = "test_domain_spine_digest",
    size = "small",
    srcs = ["test_domain_spine_digest.py"],
    data = ["//:postgres_workflow_fixtures"],
    deps = [":domain_spine"],
)

py_test(
    name = "test_render_domain_spine",
    size = "small",
    srcs = ["test_render_domain_spine.py"],
    data = ["@rules_rust//rust/toolchain:current_rustfmt_toolchain"],
    env = {"RUSTFMT": "$(rootpath @rules_rust//rust/toolchain:current_rustfmt_toolchain)"},
    deps = [":domain_spine"],
)

py_test(
    name = "test_check_docs_consistency",
    size = "small",
    srcs = ["test_check_docs_consistency.py"],
    # These fixtures execute the host's Git.
    tags = ["external"],
    deps = [":check_docs_consistency"],
)

py_test(
    name = "test_postgres_integration_suites",
    size = "small",
    srcs = ["test_postgres_integration_suites.py"],
    data = ["//:postgres_workflow_fixtures"],
    deps = [":postgres_integration_suites"],
)

py_test(
    name = "test_generate_git_scale",
    size = "small",
    srcs = ["test_generate_git_scale.py"],
    data = ["//:tooling/generate-git-scale.py"],
)

py_test(
    name = "test_ci_revision_fetch",
    size = "small",
    srcs = ["test_ci_revision_fetch.py"],
    data = ["//:ci_comparison_workflows"],
    # The fixtures exercise shallow fetches with the host Git executable.
    tags = ["external"],
    deps = [
        ":check_migration_versions",
        requirement("PyYAML"),
    ],
)

py_library(
    name = "ci_bazel_scope",
    srcs = ["ci_bazel_scope.py"],
    imports = ["."],
    deps = [":postgres_integration_suites"],
)

py_test(
    name = "test_ci_bazel_scope",
    size = "small",
    srcs = ["test_ci_bazel_scope.py"],
    deps = [":ci_bazel_scope"],
)

py_library(
    name = "summarize_bazel_test_cache",
    srcs = ["summarize_bazel_test_cache.py"],
    imports = ["."],
)

py_test(
    name = "test_summarize_bazel_test_cache",
    size = "small",
    srcs = ["test_summarize_bazel_test_cache.py"],
    deps = [":summarize_bazel_test_cache"],
)

test_suite(
    name = "checker_tests",
    visibility = ["//visibility:public"],
)

py_library(
    name = "measure_docker_resources",
    srcs = ["measure_docker_resources.py"],
    imports = ["."],
)

py_test(
    name = "test_measure_docker_resources",
    size = "small",
    srcs = ["test_measure_docker_resources.py"],
    deps = [":measure_docker_resources"],
)
